# ==============================================================================
# AVISO ARQUITECTÓNICO: ÚNICA FUENTE DE LA VERDAD
# ==============================================================================
# La plataforma opera de forma 100% dockerizada bajo una única fuente de la
# verdad para variables de entorno.
#
# Configura tus variables directamente en el archivo .env ubicado en la RAÍZ
# del proyecto (ver .env.example en la raíz). Docker Compose se encarga de
# suministrar los valores automáticamente tanto en build como en runtime.
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:5005
NEXT_PUBLIC_WS_URL=http://localhost:5005/hubs
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
NEXT_PUBLIC_PLATFORM_DOMAIN=delivery.com
PORT=3005
