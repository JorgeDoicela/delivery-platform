# ==========================================
# Variables de Entorno Locales para Frontend (Next.js)
# ==========================================

# URL de la API de Backend (.NET 8)
NEXT_PUBLIC_API_URL=http://localhost:5005

# URL de SignalR WebSockets Hubs
NEXT_PUBLIC_WS_URL=http://localhost:5005/hubs

# URL del estilo de mapa vectorial (MapLibre GL JS)
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Puerto del Frontend
PORT=3005

