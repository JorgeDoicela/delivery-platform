# ==============================================================================
# Delivery Platform - Archivo Canónico de Variables de Entorno (.env)
# ÚNICA FUENTE DE LA VERDAD PARA EL STACK DOCKERIZADO (Dev & Prod)
# ==============================================================================
# Instrucciones:
# 1. Copiar este archivo a .env en la raíz del proyecto (local o en el VPS).
# 2. En producción, reemplazar todas las contraseñas y claves por valores seguros.
# 3. Docker Compose inyectará automáticamente estas variables a todos los contenedores.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Puertos de Servicios y Aislamiento Perimetral
# ------------------------------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443
PORT=3005
API_PORT=5005
POSTGRES_PORT=5432
REDIS_PORT=6379
# En produccion, 127.0.0.1 impide exponer la BD, Redis, Backend y Frontend a internet
POSTGRES_BIND_IP=127.0.0.1
REDIS_BIND_IP=127.0.0.1
API_BIND_IP=127.0.0.1
FRONTEND_BIND_IP=127.0.0.1

# ------------------------------------------------------------------------------
# 2. Registro de Contenedores Docker (GHCR / Prefijo de Imagenes)
# ------------------------------------------------------------------------------
IMAGE_REGISTRY_PREFIX=ghcr.io/jorgedoicela/delivery-platform

# ------------------------------------------------------------------------------
# 3. Base de Datos Relacional y Espacial (PostgreSQL 16 + PostGIS)
# ------------------------------------------------------------------------------
POSTGRES_DB=delivery
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password

# ------------------------------------------------------------------------------
# 4. Motor de Caché, Idempotencia y GEO Tracking (Redis 7)
# ------------------------------------------------------------------------------
REDIS_PASSWORD=redis_dev_password

# ------------------------------------------------------------------------------
# 5. Backend API y Seguridad (.NET 8 + JWT)
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
JWT_SECRET=super_secret_dev_key_must_be_at_least_32_characters_long_12345
JWT_ISSUER=DeliveryPlatform.Api
JWT_AUDIENCE=DeliveryPlatform.Clients
INITIAL_ADMIN_PASSWORD=CambiarEstaClaveEnProduccion123!

# ------------------------------------------------------------------------------
# 6. Frontend Web, Subdominio Unificado y Nginx (Next.js 16)
# ------------------------------------------------------------------------------
PLATFORM_DOMAIN=mesafy.doicela.dev
NEXT_PUBLIC_PLATFORM_DOMAIN=mesafy.doicela.dev
NEXT_PUBLIC_API_URL=http://localhost:5005
NEXT_PUBLIC_WS_URL=http://localhost:5005/hubs
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
INTERNAL_API_URL=http://backend:5005

# ------------------------------------------------------------------------------
# 7. Autenticación Federada Google OAuth 2.0 (Opcional)
# ------------------------------------------------------------------------------
# ClientId de Google Cloud Console para verificación en backend y renderizado del botón
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
