# ==========================================
# Base de Datos PostgreSQL + PostGIS
# ==========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=delivery
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password

# Cadena de conexión para Entity Framework Core (.NET)
DATABASE_CONNECTION_STRING="Host=localhost;Port=5432;Database=delivery;Username=postgres;Password=postgres_dev_password"

# ==========================================
# Redis 7 (Caché, Idempotencia, Tracking)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password
REDIS_CONNECTION_STRING="localhost:6379,password=redis_dev_password,abortConnect=false"

# ==========================================
# API .NET 8 (Backend)
# ==========================================
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5005
API_URL=http://localhost:5005
JWT_SECRET=super_secret_dev_key_must_be_at_least_32_characters_long_12345
JWT_ISSUER=DeliveryApi
JWT_AUDIENCE=DeliveryClients

# ==========================================
# Frontend (Next.js)
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:5005
NEXT_PUBLIC_WS_URL=http://localhost:5005/hubs
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
PORT=3005
