# Manejo universal de saltos de línea
* text=auto eol=lf

# Scripts y archivos de infraestructura estrictamente LF
*.sh text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
Dockerfile text eol=lf

# Archivos de solución y proyecto .NET
*.sln text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf

# Archivos binarios
*.p12 binary
*.pfx binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.pdf binary
