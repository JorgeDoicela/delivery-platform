{
  "name": "delivery-platform-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:status": "docker compose ps",
    "dev:backend": "dotnet run --project backend/src/Delivery.Api",
    "dev:backend:watch": "dotnet watch --project backend/src/Delivery.Api",
    "dev:frontend": "pnpm --filter frontend dev",
    "docker:all": "docker compose --profile all up -d",
    "lint:frontend": "pnpm --filter frontend lint",
    "build:frontend": "pnpm --filter frontend build",
    "build:backend": "dotnet build backend/Delivery.sln",
    "test:backend": "dotnet test backend/Delivery.sln --nologo",
    "test:frontend": "pnpm --filter frontend test",
    "test": "pnpm test:backend && pnpm test:frontend",
    "test:all": "pnpm lint:frontend && pnpm build:backend && pnpm test"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  },
  "packageManager": "pnpm@11.24.0"
}
