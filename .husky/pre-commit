#!/usr/bin/env sh

echo "[pre-commit] Verificando calidad del codigo en staging..."

# 1. Comprobacion de Frontend (Next.js / TypeScript / ESLint)
STAGED_FRONTEND=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^frontend/.*\.(ts|tsx|js|jsx)$' || true)
if [ -n "$STAGED_FRONTEND" ]; then
  echo "[pre-commit] Archivos de frontend detectados. Ejecutando linter y pruebas unitarias..."
  pnpm --filter frontend lint || {
    echo ""
    echo "[pre-commit] ERROR: Se detectaron fallos de linting en el frontend."
    echo "[pre-commit] Corrige los errores antes de confirmar el commit."
    exit 1
  }
  pnpm --filter frontend test || {
    echo ""
    echo "[pre-commit] ERROR: Se detectaron pruebas unitarias fallidas en el frontend."
    echo "[pre-commit] Corrige los errores antes de confirmar el commit."
    exit 1
  }
fi

# 2. Comprobacion de Backend (.NET 8 / C#)
STAGED_BACKEND=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^backend/.*\.(cs|csproj)$' || true)
if [ -n "$STAGED_BACKEND" ]; then
  echo "[pre-commit] Archivos de backend detectados. Ejecutando compilacion y pruebas .NET..."
  dotnet test backend/Delivery.sln -v q -nologo || {
    echo ""
    echo "[pre-commit] ERROR: La solucion de backend fallo en compilacion o pruebas."
    echo "[pre-commit] Corrige los fallos antes de confirmar el commit."
    exit 1
  }
fi

echo "[pre-commit] Todas las validaciones pasaron exitosamente."
